@page "/adicionar-livros"
@using LivrariaCore.DTO_s
@inject HttpClient Http

<h3>Adicionar Livros</h3>

      <select @bind="tipoLivro">
            <option value="">Selecione o tipo</option>
            <option value="Fisico">Fisico</option>
            <option value="Digital">Digital</option>
      </select>


      @if(tipoLivro == "Fisico"){
          
        <EditForm Model="tipoLivroFisico" OnValidSubmit="CadastroLivro">
            <DataAnnotationsValidator />
        
            <span>Digite o ID do livro: </span>
            <input type="number" placeholder="Ex: 9" @bind="tipoLivroFisico.ID" />
            <hr />

            <span>Digite o nome do livro: </span>
            <input type="text" placeholder="Ex: Dom Casmurro" @bind="tipoLivroFisico.Nome" />
            <hr />

            <span>Digite o autor do livro: </span>
            <input type="text" placeholder="Ex: Machado de Assis..." @bind="tipoLivroFisico.Autor" />
            <hr />

            <span>Digite o preço do livro: </span>
            <input type="number" step="0.01" placeholder="Ex: 45" @bind="tipoLivroFisico.Preco" />
            <hr />

            <span>Digite o tipo de capa do livro: </span>
            <input type="text" placeholder="Ex: SIMPLES" @bind="tipoLivroFisico.TipoCapa" />
            <hr />

            <span>Digite a quantidade do livro: </span>
            <input type="number" placeholder="Ex: 2" @bind="tipoLivroFisico.Quantidade" />
            <hr />

            <button class="btn btn-primary" type="submit">Adicionar Livro</button>
            <br />

        
            <ValidationSummary />
        </EditForm>
      }else if(tipoLivro == "Digital"){
        <EditForm Model="tipoLivroDigital" OnValidSubmit="CadastroLivro">

            <DataAnnotationsValidator />

            <span>Digite o ID do livro: </span>
            <input type="number" placeholder="Ex: 2" @bind="tipoLivroDigital.ID" />
            <hr />

            <span>Digite o nome do livro: </span>
            <input type="text" placeholder="Ex : Five Nights at Freddy's" @bind="tipoLivroDigital.Nome" />
            <hr />

            <span>Digite o autor do livro: </span>
            <input type="text" placeholder="Ex: " @bind="tipoLivroDigital.Autor" />
            <hr />

            <span>Digite o preço do livro: </span>
            <input type="number"  step="0.01" placeholder="Ex: 24,76" @bind="tipoLivroDigital.Preco" />
            <hr />

            <span>Digite o formato do livro: </span>
            <input type="text" placeholder="Ex: PDF" @bind="tipoLivroDigital.Formato" />
            <hr />

            <span>Digite a quantidade do livro: </span>
            <input type="number" placeholder="Ex: 2" @bind="tipoLivroDigital.Quantidade" />
            <hr />

            <button class="btn btn-primary" type="submit">Adicionar Livro</button>
            <br />




            <ValidationSummary />

        </EditForm>
      }

    

    





    @if (!string.IsNullOrWhiteSpace(mensagem))
    {
        if (sucesso)
        {
            <div class="alert alert-success">@mensagem</div>
        }
        else
        {
            <div class="alert alert-danger">@mensagem</div>
        }



    }


@code {

    private string tipoLivro = string.Empty;
 

    private bool sucesso = false;
    private string mensagem = string.Empty;

    private LivroFisicoDTO tipoLivroFisico = new LivroFisicoDTO();
    private LivroDigitalDTO tipoLivroDigital = new LivroDigitalDTO();

    private async Task CadastroLivro()
    {


        Console.WriteLine($"Tipo selecionado: {tipoLivro}");


        HttpResponseMessage resposta;

        if (tipoLivro == "Fisico")
        {
            resposta = await Http.PostAsJsonAsync("https://localhost:7020/api/livro/fisicos", tipoLivroFisico);

        }else
        {
            resposta = await Http.PostAsJsonAsync("https://localhost:7020/api/livro/digitais", tipoLivroDigital);
        }


        if (resposta.IsSuccessStatusCode)
        {
            sucesso = true;
            mensagem = "Livro Adicionado com Sucesso!!";


        }else
        {
            sucesso = false;
            var erro = await resposta.Content.ReadFromJsonAsync<ErroResponse>();
            Console.WriteLine($"Erro lido: {erro?.Error}");
            mensagem = erro?.Error ?? "Erro ao cadastrar livro";
            Console.WriteLine($"Mensagem definida: {mensagem}");
            

        }

        Console.WriteLine($"Status da resposta: {resposta.StatusCode}");
    }



    public class ErroResponse
    {
        public string Error { get; set; } = string.Empty;    
    }


}
