@page "/adicionar-livros"
@using LivrariaCore.DTO_s
@inject HttpClient Http

<h3>Adicionar Livros</h3>

        <div class="mb-4" style="max-width: 300px;">
            <label class="form-label">Tipo do livro</label>
            <select class="form-select" @bind="tipoLivro">
                <option value="">Selecione o tipo</option>
                <option value="Fisico">Físico</option>
                <option value="Digital">Digital</option>
            </select>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensagem))
        {
            if (sucesso)
            {
                <div class="alert alert-success">@mensagem</div>
            }
            else
            {
                <div class="alert alert-danger">@mensagem</div>
            }



        }


      @if(tipoLivro == "Fisico"){
          
        <EditForm Model="tipoLivroFisico" OnValidSubmit="CadastroLivro">
            <DataAnnotationsValidator />
            
            <div class="card shadow-sm" style="max-width: 600px;">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">ID do livro</label>
                        <input type="number" class="form-control" placeholder="Ex: 9" @bind="tipoLivroFisico.ID" />

                    </div>


                    <div class="mb-3">
                        <label class="form-label">Nome do livro</label>
                        <input type="text" class="form-control" placeholder="Ex: Dom Casmurro" @bind="tipoLivroFisico.Nome" />

                    </div>

          
                    <div class="mb-3">

                        <label class="form-label">Autor do livro</label>
                        <input type="text" class="form-control" placeholder="Ex: Machado de Assis..." @bind="tipoLivroFisico.Autor" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Preço do livro</label>
                        <input type="number" class="form-control" step="0.01" placeholder="Ex: 45" @bind="tipoLivroFisico.Preco" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Tipo de capa do livro</label>
                        <input type="text" class="form-control" placeholder="Ex: SIMPLES" @bind="tipoLivroFisico.TipoCapa" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Quantidade do livro</label>
                        <input type="number" class="form-control" placeholder="Ex: 2" @bind="tipoLivroFisico.Quantidade" />

                    </div>


                    <button class="btn btn-primary" type="submit">Adicionar Livro</button>
                </div>
            </div>

            

        
            <ValidationSummary />
        </EditForm>
      }else if(tipoLivro == "Digital"){
        <EditForm Model="tipoLivroDigital" OnValidSubmit="CadastroLivro">

            <DataAnnotationsValidator />

            <div class="card shadow-sm" style="max-width: 600px;">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">ID do livro</label>
                        <input type="number" class="form-control" placeholder="Ex: 9" @bind="tipoLivroDigital.ID" />

                    </div>


                    <div class="mb-3">
                        <label class="form-label">Nome do livro</label>
                        <input type="text" class="form-control" placeholder="Ex: Dom Casmurro" @bind="tipoLivroDigital.Nome" />

                    </div>

          
                    <div class="mb-3">

                        <label class="form-label">Autor do livro</label>
                        <input type="text" class="form-control" placeholder="Ex: Machado de Assis..." @bind="tipoLivroDigital.Autor" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Preço do livro</label>
                        <input type="number" class="form-control" step="0.01" placeholder="Ex: 55" @bind="tipoLivroDigital.Preco" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Formato do livro</label>
                        <input type="text" class="form-control" placeholder="Ex: PDF" @bind="tipoLivroDigital.Formato" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Quantidade do livro</label>
                        <input type="number" class="form-control" placeholder="Ex: 2" @bind="tipoLivroDigital.Quantidade" />

                    </div>


                    <button class="btn btn-primary" type="submit">Adicionar Livro</button>
                </div>
            </div>




            <ValidationSummary />

        </EditForm>
      }

    



@code {

    private string tipoLivro = string.Empty;
 

    private bool sucesso = false;
    private string mensagem = string.Empty;

    private LivroFisicoDTO tipoLivroFisico = new LivroFisicoDTO();
    private LivroDigitalDTO tipoLivroDigital = new LivroDigitalDTO();

    private async Task CadastroLivro()
    {


        Console.WriteLine($"Tipo selecionado: {tipoLivro}");


        HttpResponseMessage resposta;

        if (tipoLivro == "Fisico")
        {
            resposta = await Http.PostAsJsonAsync("https://localhost:7020/api/livro/fisicos", tipoLivroFisico);

        }else
        {
            resposta = await Http.PostAsJsonAsync("https://localhost:7020/api/livro/digitais", tipoLivroDigital);
        }


        if (resposta.IsSuccessStatusCode)
        {
            sucesso = true;
            mensagem = "Livro Adicionado com Sucesso!!";


        }else
        {
            sucesso = false;
            var erro = await resposta.Content.ReadFromJsonAsync<ErroResponse>();
            Console.WriteLine($"Erro lido: {erro?.Error}");
            mensagem = erro?.Error ?? "Erro ao cadastrar livro";
            Console.WriteLine($"Mensagem definida: {mensagem}");
            

        }

        Console.WriteLine($"Status da resposta: {resposta.StatusCode}");
    }



    public class ErroResponse
    {
        public string Error { get; set; } = string.Empty;    
    }


}
