@page "/cadastrar-pedido"

@using LivrariaCore.DTO_s
@using LivrariaCore.Models

@inject HttpClient Http

<h3 class="mb-4">Cadastrar Pedido</h3>

@if (!string.IsNullOrWhiteSpace(mensagem))
{
    <div class="alert @(sucesso ? "alert-success" : "alert-danger")">@mensagem</div>
}

<div class="card shadow-sm mb-4" style="max-width: 600px;">
    <div class="card-header">
        <strong>Dados do Cliente</strong>
    </div>
    <div class="card-body">
        <EditForm Model="novoPedido">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">ID do pedido</label>
                <InputNumber class="form-control" placeholder="Ex: 999" @bind-Value="novoPedido.IdPedido" />
            </div>

            <div class="mb-3">
                <label class="form-label">Nome do cliente</label>
                <InputText class="form-control" placeholder="Ex: Lucas Silva" @bind-Value="novoPedido.NomeCliente" />
            </div>

            <div class="mb-3">
                <label class="form-label">Telefone</label>
                <InputText class="form-control" placeholder="Ex: 16 99999-9999" @bind-Value="novoPedido.TelefoneCliente" />
            </div>

            <ValidationSummary class="text-danger" />
        </EditForm>
    </div>
</div>

@if (!confirmarAcao)
{
    <button type="button" class="btn btn-primary mb-4" @onclick="() => confirmarAcao = true">
        + Adicionar Itens
    </button>
}

@if (confirmarAcao)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <strong>Livros Físicos</strong>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Preço</th>
                        <th>Tipo Capa</th>
                        <th>Qtd Disponível</th>
                        <th>Qtd Desejada</th>
                        <th>Ação</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fisico in livrosFisicos!)
                    {
                        <tr>
                            <td>@fisico.Id</td>
                            <td>@fisico.Nome</td>
                            <td>R$ @fisico.Preco.ToString("N2")</td>
                            <td>@fisico.TipoCapa</td>
                            <td>@fisico.Quantidade</td>
                            <td style="max-width: 120px;">
                                <input type="number"
                                       class="form-control form-control-sm"
                                       min="0"
                                       max="@fisico.Quantidade"
                                       value="@quantidades![fisico.Id]"
                                       @onchange="e => AtualizarQuantidade(fisico.Id, e)" />
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        @onclick="() => AdicionarItem(fisico)">
                                    Adicionar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <strong>Livros Digitais</strong>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Preço</th>
                        <th>Formato</th>
                        <th>Qtd Disponível</th>
                        <th>Qtd Desejada</th>
                        <th>Ação</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var digital in livrosDigitais!)
                    {
                        <tr>
                            <td>@digital.Id</td>
                            <td>@digital.Nome</td>
                            <td>R$ @digital.Preco.ToString("N2")</td>
                            <td>@digital.Formato</td>
                            <td>@digital.Quantidade</td>
                            <td style="max-width: 120px;">
                                <input type="number"
                                       class="form-control form-control-sm"
                                       min="0"
                                       max="@digital.Quantidade"
                                       value="@quantidades![digital.Id]"
                                       @onchange="e => AtualizarQuantidade(digital.Id, e)" />
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-success"
                                        @onclick="() => AdicionarItem(digital)">
                                    Adicionar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (novoPedido!.Itens.Any())
    {
        <div class="card shadow-sm mb-4" style="max-width: 600px;">
            <div class="card-header">
                <strong>Itens do Pedido</strong>
                <span class="badge bg-secondary ms-2">@novoPedido.Itens.Count</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Livro (ID)</th>
                            <th>Quantidade</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in novoPedido.Itens)
                        {
                            <tr>
                                <td>@item.LivroId</td>
                                <td>@item.QuantidadeLivros</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            @onclick="() => RemoverItem(item.LivroId)">
                                        Remover
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <p class="text-muted mb-4">Nenhum item adicionado ainda.</p>
    }
}

<div class="d-flex gap-2 mb-4">
    <button type="button" class="btn btn-primary" @onclick="CriarPedido">
        Criar Pedido
    </button>
    <a href="/pedidos" class="btn btn-outline-secondary">Cancelar</a>
</div>

@code {

    private List<LivroFisico>? livrosFisicos;
    private List<LivroDigital>? livrosDigitais;

    private Dictionary<int, int>? quantidades = new();

    private bool confirmarAcao = false;
    private bool sucesso = false;
    private string mensagem = string.Empty;

    private PedidoDTO? novoPedido = new PedidoDTO();

    private async Task CriarPedido()
    {
        if (string.IsNullOrWhiteSpace(novoPedido!.NomeCliente) || novoPedido.IdPedido <= 0)
        {
            mensagem = "Preencha todos os campos obrigatórios";
            sucesso = false;
            return;
        }

        if (!novoPedido.Itens.Any())
        {
            mensagem = "Adicione ao menos um item ao pedido";
            sucesso = false;
            return;
        }

        HttpResponseMessage resposta = await Http.PostAsJsonAsync("https://localhost:7020/api/pedido", novoPedido);

        if (resposta.IsSuccessStatusCode)
        {
            sucesso = true;
            mensagem = "Pedido adicionado com sucesso!";
        }
        else
        {
            sucesso = false;
            var erro = await resposta.Content.ReadFromJsonAsync<ErrorResponse>();
            mensagem = erro?.Error ?? "Erro ao cadastrar o pedido";
        }
    }

    private void AdicionarItem(Livro livro)
    {
        var quantidade = quantidades!.GetValueOrDefault(livro.Id, 0);

        if (quantidade <= 0)
        {
            mensagem = "Informe uma quantidade maior que zero antes de adicionar.";
            sucesso = false;
            return;
        }

        var itemExistente = novoPedido!.Itens.FirstOrDefault(p => p.LivroId == livro.Id);
        if (itemExistente != null)
        {
            itemExistente.QuantidadeLivros += quantidade;
        }
        else
        {
            novoPedido.Itens.Add(new ItemPedidoDTO
            {
                LivroId = livro.Id,
                QuantidadeLivros = quantidade,
            });
        }

        quantidades[livro.Id] = 0;
        mensagem = string.Empty;
    }

    private void RemoverItem(int livroId)
    {
        var item = novoPedido!.Itens.FirstOrDefault(p => p.LivroId == livroId);
        if (item != null)
        {
            novoPedido.Itens.Remove(item);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        livrosFisicos = await Http.GetFromJsonAsync<List<LivroFisico>>("https://localhost:7020/api/livro/consultafisicos");
        livrosDigitais = await Http.GetFromJsonAsync<List<LivroDigital>>("https://localhost:7020/api/livro/consultadigitais");

        foreach (var livro in livrosFisicos!)
            quantidades![livro.Id] = 0;

        foreach (var livro in livrosDigitais!)
            quantidades![livro.Id] = 0;
    }

    public class ErrorResponse
    {
        public string Error { get; set; } = string.Empty;
    }

    private void AtualizarQuantidade(int livroId, ChangeEventArgs e)
    {
        quantidades![livroId] = Convert.ToInt32(e.Value);
    }
}