@page "/editar-livros/{Tipo}/{Id:int}"
@using LivrariaCore.DTO_s

@inject HttpClient Http

<h3 class="mb-4">Editar Livro</h3>

@if (fisico == null && digital == null)
{
    <p>Carregando...</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(mensagem))
    {
        <div class="alert @(sucesso ? "alert-success" : "alert-danger")">@mensagem</div>
    }

    @if (Tipo == "Fisico")
    {
        <div class="card shadow-sm" style="max-width: 600px;">
            <div class="card-header bg-primary text-white">
                <strong>Livro Físico #@fisico?.ID</strong>
            </div>
            <div class="card-body">
                <EditForm Model="fisico" OnValidSubmit="EditarLivro">
                    <DataAnnotationsValidator />

                    <InputNumber @bind-Value="fisico.ID" hidden />

                    <div class="mb-3">
                        <label class="form-label">Nome</label>
                        <InputText class="form-control" placeholder="Ex: Harry Potter" @bind-Value="fisico.Nome" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Autor</label>
                        <InputText class="form-control" placeholder="Ex: J.K. Rowling" @bind-Value="fisico.Autor" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Preço</label>
                        <InputNumber class="form-control" @bind-Value="fisico.Preco" step="0.01" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tipo da capa</label>
                        <InputText class="form-control" placeholder="Ex: DURA" @bind-Value="fisico.TipoCapa" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Quantidade</label>
                        <InputNumber class="form-control" @bind-Value="fisico.Quantidade" />
                    </div>

                    <ValidationSummary class="text-danger" />

                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary" type="submit">Salvar alterações</button>
                        <a href="/catalogo" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </EditForm>
            </div>
        </div>
    }
    else if (Tipo == "Digital")
    {
        <div class="card shadow-sm" style="max-width: 600px;">
            <div class="card-header bg-success text-white">
                <strong>Livro Digital #@digital?.ID</strong>
            </div>
            <div class="card-body">
                <EditForm Model="digital" OnValidSubmit="EditarLivro">
                    <DataAnnotationsValidator />

                    <InputNumber @bind-Value="digital.ID" hidden />

                    <div class="mb-3">
                        <label class="form-label">Nome</label>
                        <InputText class="form-control" placeholder="Ex: Harry Potter" @bind-Value="digital.Nome" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Autor</label>
                        <InputText class="form-control" placeholder="Ex: J.K. Rowling" @bind-Value="digital.Autor" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Preço</label>
                        <InputNumber class="form-control" @bind-Value="digital.Preco" step="0.01" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Formato</label>
                        <InputText class="form-control" placeholder="Ex: PDF" @bind-Value="digital.Formato" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Quantidade</label>
                        <InputNumber class="form-control" @bind-Value="digital.Quantidade" />
                    </div>

                    <ValidationSummary class="text-danger" />

                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary" type="submit">Salvar alterações</button>
                        <a href="/catalogo" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </EditForm>
            </div>
        </div>
    }
}


@code {


    [Parameter]
    public int Id { get; set; }

    [Parameter]
    public string Tipo { get; set; } = string.Empty;

    private LivroFisicoDTO? fisico;
    private LivroDigitalDTO? digital;

    

    private bool sucesso = false;
    private string mensagem = string.Empty;

    protected override async Task OnInitializedAsync()
    {

        if (Tipo == "Fisico")
        {

            fisico = await Http.GetFromJsonAsync<LivroFisicoDTO>
                ($"https://localhost:7020/api/livro/{Id}");
        }else if (Tipo == "Digital")
        {
            digital = await Http.GetFromJsonAsync<LivroDigitalDTO>
               ($"https://localhost:7020/api/livro/{Id}");
        }


    }
     
   

    private async Task EditarLivro()
    {

        HttpResponseMessage resposta;

        if(Tipo == "Fisico"){

            resposta = await Http.PutAsJsonAsync($"https://localhost:7020/api/livro/fisicos/{fisico?.ID}", fisico);
        }else{
        
            resposta = await Http.PutAsJsonAsync($"https://localhost:7020/api/livro/digitais/{digital?.ID}", digital);
        }
        


        if (resposta.IsSuccessStatusCode)
        {
            sucesso = true;
            mensagem = "Livro Editado com Sucesso!!";
        }
        else
        {
            sucesso = false;
            var erro = await resposta.Content.ReadFromJsonAsync<ErroResponse>();
            mensagem = erro?.Error ?? "Erro ao editar livro";
        }



    }



    public class ErroResponse
    {
        public string Error { get; set; } = string.Empty;
    }

}