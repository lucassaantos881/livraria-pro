@page "/catalogo"
@using LivrariaCore.Models
@inject HttpClient Http
@inject IJSRuntime JS

<h3 class="mb-4">Catálogo de Livros</h3>

@if (livrosFisicos == null)
{
    <p>Carregando...</p>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <strong>Livros Físicos</strong>
            <span class="badge bg-light text-dark ms-2">@livrosFisicos.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>Formato Capa</th>
                        <th>Preço</th>
                        <th>Preço com Frete</th>
                        <th>Quantidade</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fisico in livrosFisicos!)
                    {
                        <tr>
                            <td>@fisico.Id</td>
                            <td>@fisico.Nome</td>
                            <td>@fisico.Autor</td>
                            <td>@fisico.TipoCapa</td>
                            <td>R$ @fisico.Preco.ToString("N2")</td>
                            <td>R$ @fisico.CalculoPrecoUnitario().ToString("N2")</td>
                            <td>@fisico.Quantidade</td>
                            <td>
                                <a href="editar-livros/Fisico/@fisico.Id" class="btn btn-sm btn-outline-primary">
                                    Editar
                                </a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarExclusao(fisico.Id)">
                                    Excluir
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <strong>Livros Digitais</strong>
            <span class="badge bg-light text-dark ms-2">@livrosDigitais!.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Autor</th>
                        <th>Formato</th>
                        <th>Preço</th>
                        <th>Preço com Desconto</th>
                        <th>Quantidade</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var digital in livrosDigitais!)
                    {
                        <tr>
                            <td>@digital.Id</td>
                            <td>@digital.Nome</td>
                            <td>@digital.Autor</td>
                            <td>@digital.Formato</td>
                            <td>R$ @digital.Preco.ToString("N2")</td>
                            <td>R$ @digital.CalculoPrecoUnitario().ToString("N2")</td>
                            <td>@digital.Quantidade</td>
                            <td>
                                <a href="editar-livros/Digital/@digital.Id" class="btn btn-sm btn-outline-primary">
                                    Editar
                                </a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarExclusao(digital.Id)">
                                    Excluir
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <hr class="my-4" />

    <h4 class="mb-3">Buscar Livro por ID</h4>

    <div class="d-flex gap-2 mb-4" style="max-width: 400px;">
        <input class="form-control" @bind="idBusca" placeholder="ID do Livro" />
        <button class="btn btn-primary" @onclick="BuscarLivro">Buscar</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensagem))
    {
        <div class="alert @(sucesso ? "alert-success" : "alert-danger")">@mensagem</div>
    }

    @if (livroBuscado != null)
    {
        <div class="card shadow-sm" style="max-width: 500px;">
            <div class="card-header">
                <strong>Livro Encontrado</strong>
                <span class="badge @(livroBuscado is LivroFisico ? "bg-primary" : "bg-success") ms-2">
                    @(livroBuscado is LivroFisico ? "Físico" : "Digital")
                </span>
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>Nome:</strong> @livroBuscado.Nome</p>
                <p class="mb-1"><strong>Autor:</strong> @livroBuscado.Autor</p>
                <p class="mb-1"><strong>Preço:</strong> R$ @livroBuscado.Preco.ToString("N2")</p>
                <p class="mb-3"><strong>Quantidade:</strong> @livroBuscado.Quantidade</p>

                <p class="fs-5 mb-0">
                    <strong>Preço Total: R$ @livroBuscado.CalculoPrecoUnitario().ToString("N2")</strong>
                </p>
            </div>
        </div>
    }
}


@code {

    private List<LivroFisico>? livrosFisicos;
    private List<LivroDigital>? livrosDigitais;

    private int idBusca;

    private Livro? livroBuscado;

    private bool sucesso = false;
    private string mensagem = string.Empty;


    private async Task BuscarLivro()
    {
        if (idBusca <= 0)
        {
            return;
        }
        else
        {
            livroBuscado = livrosFisicos?.FirstOrDefault(f => f.Id == idBusca);

            if (livroBuscado == null)
            {
                livroBuscado = livrosDigitais?.FirstOrDefault(d => d.Id == idBusca);
            }



        }
    }

    private async Task ConfirmarExclusao(int id)
    {
        // Abre o "confirm" nativo do navegador. Retorna true se clicar em OK e false se Cancelar.
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja deletar este livro?");

        if (confirmado)
        {
            // Se o usuário confirmou, aí sim chamamos o seu método original
            await DeletarLivro(id);
         
        }
        // Se ele clicar em Cancelar, o código simplesmente para aqui e nada acontece!
    }

    private async Task DeletarLivro(int id)
    {
        HttpResponseMessage resposta;

        if (id <= 0)
        {
            return;
        }

        var fis = livrosFisicos?.Any(f => f.Id == id) ?? false;
        var dig = livrosDigitais?.Any(d => d.Id == id) ?? false;

        resposta = await Http.DeleteAsync($"https://localhost:7020/api/livro/{id}");

        if (resposta.IsSuccessStatusCode)
        {
            if (fis)
            {
                var livroNaTela = livrosFisicos?.FirstOrDefault(f => f.Id == id);

                if (livroNaTela != null)
                {
                    
                    livrosFisicos?.Remove(livroNaTela);

                }


                
            }else if (dig)
            {
                var livroNaTela = livrosDigitais?.First(d => d.Id == id);

                if(livroNaTela != null)
                {
                    livrosDigitais?.Remove(livroNaTela);

                }

                
            }

            sucesso = true;
            mensagem = "Livro Deletado com Sucesso!!";
        }
        else
        {
            sucesso = false;
            var erro = await resposta.Content.ReadFromJsonAsync<ErroResponse>();
            mensagem = erro?.Error ?? "Erro ao deletar livro";
        }



    }

    protected override async Task OnInitializedAsync()
    {
        //Chama a API e armazena na Lista
        livrosFisicos = await Http.GetFromJsonAsync<List<LivroFisico>>("https://localhost:7020/api/livro/consultafisicos");
        livrosDigitais = await Http.GetFromJsonAsync<List<LivroDigital>>("https://localhost:7020/api/livro/consultadigitais");


    }

    public class ErroResponse
    {
        public string Error { get; set; } = string.Empty;
    }


}
